{
  "name": "sidwave",
  "version": "0.1.0",
  "description": "SIDWave music format for the SID chip: parser, compiler to C64 PRG and PSID, linter, generator and offline analysis",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sidwave": "./bin/sidwave.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sidwave": {
      "types": "./dist/sidwave.d.ts",
      "default": "./dist/sidwave.js"
    },
    "./compiler": {
      "types": "./dist/sidwaveCompiler.d.ts",
      "default": "./dist/sidwaveCompiler.js"
    },
    "./game": {
      "types": "./dist/sidwaveGame.d.ts",
      "default": "./dist/sidwaveGame.js"
    },
    "./digi": {
      "types": "./dist/sidwaveDigi.d.ts",
      "default": "./dist/sidwaveDigi.js"
    },
    "./pcm": {
      "types": "./dist/sidwavePcm.d.ts",
      "default": "./dist/sidwavePcm.js"
    },
    "./form": {
      "types": "./dist/sidwaveForm.d.ts",
      "default": "./dist/sidwaveForm.js"
    },
    "./filterModel": {
      "types": "./dist/sidwaveFilterModel.d.ts",
      "default": "./dist/sidwaveFilterModel.js"
    },
    "./lint": {
      "types": "./dist/sidwaveLint.d.ts",
      "default": "./dist/sidwaveLint.js"
    },
    "./examples": {
      "types": "./dist/sidwaveExamples.d.ts",
      "default": "./dist/sidwaveExamples.js"
    },
    "./generate": {
      "types": "./dist/audio/generateSidwave.d.ts",
      "default": "./dist/audio/generateSidwave.js"
    },
    "./reference": {
      "types": "./dist/audio/sidwaveReference.d.ts",
      "default": "./dist/audio/sidwaveReference.js"
    },
    "./similarity": {
      "types": "./dist/audio/sidwaveSimilarity.d.ts",
      "default": "./dist/audio/sidwaveSimilarity.js"
    },
    "./fidelity": {
      "types": "./dist/audio/sidwaveFidelity.d.ts",
      "default": "./dist/audio/sidwaveFidelity.js"
    },
    "./quality": {
      "types": "./dist/audio/sidwaveQuality.d.ts",
      "default": "./dist/audio/sidwaveQuality.js"
    },
    "./sid-file": {
      "types": "./dist/sidFile.d.ts",
      "default": "./dist/sidFile.js"
    },
    "./songlengths": {
      "types": "./dist/songlengths.d.ts",
      "default": "./dist/songlengths.js"
    },
    "./hvsc": {
      "types": "./dist/hvscIndex.d.ts",
      "default": "./dist/hvscIndex.js"
    },
    "./engine": {
      "types": "./dist/engine/libsidplayfp.d.ts",
      "default": "./dist/engine/libsidplayfp.js"
    },
    "./verify": {
      "types": "./dist/verify/index.d.ts",
      "default": "./dist/verify/index.js"
    },
    "./format": {
      "types": "./dist/format/sidwaveFormat.d.ts",
      "default": "./dist/format/sidwaveFormat.js"
    },
    "./retarget": {
      "types": "./dist/retarget.d.ts",
      "default": "./dist/retarget.js"
    },
    "./transform": {
      "types": "./dist/transform/index.d.ts",
      "default": "./dist/transform/index.js"
    },
    "./reconstruct": {
      "types": "./dist/reconstruct/index.d.ts",
      "default": "./dist/reconstruct/index.js"
    },
    "./export": {
      "types": "./dist/interchange/index.d.ts",
      "default": "./dist/interchange/index.js"
    },
    "./analyze": {
      "types": "./dist/analyze/index.d.ts",
      "default": "./dist/analyze/index.js"
    },
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "imports": {
    "#test/assert": "./test/helpers/assert.js",
    "#test/runner": "./test/helpers/test.js"
  },
  "files": [
    "bin",
    "dist/**",
    "!dist/.tsbuildinfo",
    "data/**",
    "doc/licensing.md",
    "doc/tutorial.md",
    "doc/interchange.md",
    "doc/analysis.md",
    "doc/preservation.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-EXCEPTION.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx/esm --test test/*.test.mjs",
    "test:bun": "bun test test/*.test.mjs",
    "examples:game": "node examples/game/build.mjs",
    "coverage": "node ../scripts/run-package-coverage.mjs ."
  },
  "keywords": [
    "sid",
    "c64",
    "commodore-64",
    "music",
    "chiptune",
    "sidwave"
  ],
  "author": "Christian Gleissner",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisgleissner/sidwave.git",
    "directory": "sidwave"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "6502-toolkit": "^0.1.0",
    "yaml": "^2.9.0"
  },
  "homepage": "https://github.com/chrisgleissner/sidwave/tree/main/sidwave#readme",
  "bugs": {
    "url": "https://github.com/chrisgleissner/sidwave/issues"
  },
  "peerDependencies": {
    "libsidplayfp-wasm": "^1.1.1"
  },
  "peerDependenciesMeta": {
    "libsidplayfp-wasm": {
      "optional": true
    }
  },
  "devDependencies": {
    "fast-xml-parser": "^5.2.5",
    "libsidplayfp-wasm": "1.1.1",
    "midi-file": "^1.2.4",
    "wavefile": "^11.0.0"
  }
}
