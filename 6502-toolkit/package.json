{
  "name": "6502-toolkit",
  "version": "0.1.0",
  "description": "6502 assembler and disassembler with all 256 NMOS opcodes, plus Commodore PRG and PETSCII support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assembler": {
      "types": "./dist/assembler.d.ts",
      "default": "./dist/assembler.js"
    },
    "./disassembler": {
      "types": "./dist/disassembler.d.ts",
      "default": "./dist/disassembler.js"
    },
    "./opcodeInventory": {
      "types": "./dist/opcodeInventory.d.ts",
      "default": "./dist/opcodeInventory.js"
    },
    "./petscii": {
      "types": "./dist/petscii.d.ts",
      "default": "./dist/petscii.js"
    },
    "./ioRange": {
      "types": "./dist/ioRange.d.ts",
      "default": "./dist/ioRange.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#test/assert": "./test/helpers/assert.js",
    "#test/runner": "./test/helpers/test.js"
  },
  "files": [
    "dist/**",
    "!dist/.tsbuildinfo",
    "doc",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx/esm --test test/*.test.mjs",
    "test:bun": "bun test test/*.test.mjs",
    "coverage": "node ../scripts/run-package-coverage.mjs ."
  },
  "keywords": [
    "6502",
    "6510",
    "nmos",
    "assembler",
    "disassembler",
    "c64",
    "commodore",
    "nes",
    "atari",
    "retro"
  ],
  "author": "Christian Gleissner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisgleissner/sidwave.git",
    "directory": "6502-toolkit"
  },
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://github.com/chrisgleissner/sidwave/tree/main/6502-toolkit#readme",
  "bugs": {
    "url": "https://github.com/chrisgleissner/sidwave/issues"
  }
}
